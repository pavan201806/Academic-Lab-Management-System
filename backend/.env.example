# ==============================================================================
# Academic Lab Management System — Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express backend server
PORT=5000

# Node execution environment (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Local MongoDB connection URI or MongoDB Atlas connection string
# Example Local: mongodb://localhost:27017/academic_lab_management
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-url>/academic_lab_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/academic_lab_management

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens
# Replace with a cryptographically strong, random string (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Token expiration duration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & Client Integration
# ------------------------------------------------------------------------------
# Origin URL of the frontend application allowed to make API requests
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Code Execution Engine Configuration
# ------------------------------------------------------------------------------
# Active execution provider: 'judge0' (default for deployment) or 'docker' (local runner)
EXECUTION_PROVIDER=judge0

# Docker runner container image tag (used when EXECUTION_PROVIDER=docker)
RUNNER_DOCKER_IMAGE=academic-lab-runner:latest

# Judge0 Provider Settings (used when EXECUTION_PROVIDER=judge0)
# Base API URL of your Judge0 CE instance (do not include trailing slash)
# Self-hosted example: http://localhost:2358 or https://judge0.yourdomain.com
# Official / RapidAPI example: https://judge0-ce.p.rapidapi.com or https://ce.judge0.com
JUDGE0_API_URL=https://ce.judge0.com

# Authentication Token for direct self-hosted Judge0 instance (X-Auth-Token header)
JUDGE0_AUTH_TOKEN=

# RapidAPI credentials (if utilizing Judge0 via RapidAPI gateway)
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Polling and timeout limits (in milliseconds)
JUDGE0_TIMEOUT_MS=15000
JUDGE0_POLL_INTERVAL_MS=350

# Dynamic language discovery via /languages is enabled by default.
# Leave the overrides below empty unless explicit IDs are required by your custom instance.
# (For reference, ce.judge0.com currently exposes: C=103, C++=105, Java=91, Python 3=92)
JUDGE0_LANG_C=
JUDGE0_LANG_CPP=
JUDGE0_LANG_JAVA=
JUDGE0_LANG_PYTHON=


