# ==============================================================================
# Academic Lab Management System — Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express backend server
PORT=5000

# Node execution environment (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Local MongoDB connection URI or MongoDB Atlas connection string
# Example Local: mongodb://localhost:27017/academic_lab_management
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-url>/academic_lab_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/academic_lab_management

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens
# Replace with a cryptographically strong, random string (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Token expiration duration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & Client Integration
# ------------------------------------------------------------------------------
# Origin URL of the frontend application allowed to make API requests
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Code Execution Sandbox (Docker)
# ------------------------------------------------------------------------------
# Docker container image tag used by codeExecutionService for sandboxed execution
RUNNER_DOCKER_IMAGE=academic-lab-runner:latest
